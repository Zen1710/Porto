# Contact form (https://resend.com). Copy to .env.local for local testing,
# and add the same values in Vercel → Project → Settings → Environment Variables.
RESEND_API_KEY=
# Where messages from the contact form are delivered.
CONTACT_TO_EMAIL=
# Optional. Without a verified domain, Resend only sends from onboarding@resend.dev
# and only to the email address of your Resend account.
CONTACT_FROM_EMAIL=

# Optional. A GitHub token (no scopes needed for public repos) raises the API
# rate limit used to build the Changelog. Without it the build still works.
GITHUB_TOKEN=
